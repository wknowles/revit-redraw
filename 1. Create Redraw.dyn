  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n\"\"\"Create Redraw - Revit 2027 / Dynamo CPython3.\r\nIN[0]: target directory.\r\nOUT: (summary, qa)\r\n\r\nCreates a detached local Redraw RVT and adjacent baseline JSON from the active Main.\r\nThe active Main is always saved, or synchronized with central when workshared, before\r\ncopying so local unsaved changes are included in the Redraw.\r\n\r\nAfter a successful run the Redraw is saved and closed, and Main is active again.\r\nWorkflow: close Main, open the Redraw to edit; save/close it, reopen Main, then run\r\nCompare and Update Redraw.\r\n\"\"\"\r\nimport clr, os, json, math, re, uuid, tempfile\r\nfrom datetime import datetime, timezone\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\nclr.AddReference(\"RevitServices\")\r\nfrom Autodesk.Revit.DB import (Arc, Line, XYZ, LocationPoint, BuiltInCategory,\r\n    FilteredElementCollector, SpatialElementBoundaryOptions,\r\n    SpatialElementBoundaryLocation, SpecTypeId, UnitUtils, SaveAsOptions,\r\n    WorksharingSaveAsOptions, ModelPathUtils, FilePath,\r\n    OpenOptions, DetachFromCentralOption, TransactWithCentralOptions,\r\n    SynchronizeWithCentralOptions, RelinquishOptions)\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nDEC = 9\r\nMAX_CHORD_FT = 1.0 / 12.0\r\nAUDIT_PARAMETERS = [\r\n    \"Corners\",\r\n    \"Floorplan Hall\",\r\n    \"Floorplan Pavilion\",\r\n    \"Floorplan Sector\",\r\n    \"Obstruction Area\",\r\n    \"Product Code\",\r\n    \"Custom Area\",\r\n    \"Stand Length\",\r\n    \"Stand Width\"\r\n]\r\nMERGE_PARAMETERS = [\r\n    \"Floorplan Hall\",\r\n    \"Floorplan Pavilion\",\r\n    \"Floorplan Sector\",\r\n    \"Obstruction Area\",\r\n    \"Product Code\",\r\n    \"Custom Area\"\r\n]\r\n\r\ndef get_in(i, default=None):\r\n    try:\r\n        return default if IN[i] is None else IN[i]\r\n    except: return default\r\n\r\ndef as_path(v):\r\n    if v is None: return None\r\n    for a in (\"FullName\", \"Path\"):\r\n        try:\r\n            x = getattr(v, a)\r\n            if x: return str(x)\r\n        except: pass\r\n    return str(v)\r\n\r\ndef r(v): return round(float(v), DEC)\r\ndef jp(p): return [r(p.X), r(p.Y), r(p.Z)]\r\ndef dist(a,b): return math.sqrt((a.X-b.X)**2+(a.Y-b.Y)**2+(a.Z-b.Z)**2)\r\ndef same(a,b): return dist(a,b) <= 1e-9\r\n\r\ndef norm_path(p):\r\n    try: return os.path.normcase(os.path.abspath(p))\r\n    except: return p\r\n\r\ndef eid_int(eid):\r\n    # Revit 2024+ has ElementId.Value; the old IntegerValue is gone.\r\n    return int(eid.Value)\r\n\r\ndef tess(curve):\r\n    pts=list(curve.Tessellate())\r\n    if len(pts)<2: pts=[curve.GetEndPoint(0),curve.GetEndPoint(1)]\r\n    out=[pts[0]]\r\n    for i in range(1,len(pts)):\r\n        a,b=pts[i-1],pts[i]\r\n        n=max(1,int(math.ceil(dist(a,b)/MAX_CHORD_FT)))\r\n        for j in range(1,n+1):\r\n            t=float(j)/n\r\n            out.append(XYZ(a.X+(b.X-a.X)*t,a.Y+(b.Y-a.Y)*t,a.Z+(b.Z-a.Z)*t))\r\n    return out\r\n\r\ndef curve_json(c):\r\n    if isinstance(c,Line):\r\n        return {\"type\":\"LINE\",\"start\":jp(c.GetEndPoint(0)),\"end\":jp(c.GetEndPoint(1))}\r\n    if isinstance(c,Arc):\r\n        return {\"type\":\"ARC\",\"start\":jp(c.GetEndPoint(0)),\"mid\":jp(c.Evaluate(.5,True)),\"end\":jp(c.GetEndPoint(1))}\r\n    return {\"type\":\"POLYLINE\",\"source_curve_type\":c.GetType().Name,\"points\":[jp(p) for p in tess(c)]}\r\n\r\ndef loop_points(curves):\r\n    out=[]\r\n    for c in curves:\r\n        pts=[c.GetEndPoint(0),c.GetEndPoint(1)] if isinstance(c,Line) else list(c.Tessellate())\r\n        if len(pts)<2: pts=[c.GetEndPoint(0),c.GetEndPoint(1)]\r\n        if not out: out.extend(pts)\r\n        elif same(out[-1],pts[0]): out.extend(pts[1:])\r\n        else: out.extend(pts)\r\n    if out and not same(out[0],out[-1]): out.append(out[0])\r\n    return out\r\n\r\ndef signed_centroid(points):\r\n    pts=list(points)\r\n    if len(pts)>1 and same(pts[0],pts[-1]): pts=pts[:-1]\r\n    if len(pts)<3: return 0.0,None\r\n    a2=cx=cy=zs=0.0\r\n    for i,p in enumerate(pts):\r\n        q=pts[(i+1)%len(pts)]; cross=p.X*q.Y-q.X*p.Y\r\n        a2+=cross; cx+=(p.X+q.X)*cross; cy+=(p.Y+q.Y)*cross; zs+=p.Z\r\n    a=a2/2.0\r\n    if abs(a)<1e-12: return 0.0,None\r\n    return a,XYZ(cx/(6*a),cy/(6*a),zs/len(pts))\r\n\r\ndef centroid(loops):\r\n    vals=[]\r\n    for curves in loops:\r\n        a,c=signed_centroid(loop_points(curves))\r\n        if c is not None and abs(a)>1e-12: vals.append((a,c))\r\n    if not vals: return None\r\n    total=sum(a for a,c in vals)\r\n    if abs(total)>1e-12:\r\n        return XYZ(sum(a*c.X for a,c in vals)/total,\r\n                   sum(a*c.Y for a,c in vals)/total,\r\n                   sum(abs(a)*c.Z for a,c in vals)/sum(abs(a) for a,c in vals))\r\n    return max(vals,key=lambda x:abs(x[0]))[1]\r\n\r\ndef unit_meta(d):\r\n    u=d.GetUnits()\r\n    lid=u.GetFormatOptions(SpecTypeId.Length).GetUnitTypeId()\r\n    aid=u.GetFormatOptions(SpecTypeId.Area).GetUnitTypeId()\r\n    def label(x):\r\n        try:return UnitUtils.GetTypeCatalogStringForUnit(x)\r\n        except:return str(x.TypeId)\r\n    return {\"length_unit_type_id\":str(lid.TypeId),\"length_unit_label\":label(lid),\r\n            \"area_unit_type_id\":str(aid.TypeId),\"area_unit_label\":label(aid)}\r\n\r\ndef central_model_path(d):\r\n    # Revit 2027 moved this off WorksharingUtils onto Document;\r\n    # WorksharingUtils.GetCentralModelPath no longer exists. Returns None\r\n    # when the document is not workshared.\r\n    try:\r\n        return d.GetWorksharingCentralModelPath()\r\n    except Exception:\r\n        return None\r\n\r\ndef source_meta(d):\r\n    try: cloud=bool(d.IsModelInCloud)\r\n    except:\r\n        try: cloud=d.GetCloudModelPath() is not None\r\n        except: cloud=False\r\n    visible=\"\"; central=\"\"\r\n    if cloud:\r\n        try: visible=ModelPathUtils.ConvertModelPathToUserVisiblePath(d.GetCloudModelPath())\r\n        except: visible=d.PathName or d.Title\r\n        kind=\"CLOUD_WORKSHARED\" if d.IsWorkshared else \"CLOUD\"\r\n    else:\r\n        visible=d.PathName or \"\"\r\n        kind=\"WORKSHARED\" if d.IsWorkshared else \"LOCAL\"\r\n        if d.IsWorkshared:\r\n            try:\r\n                cp=central_model_path(d)\r\n                if cp is not None: central=ModelPathUtils.ConvertModelPathToUserVisiblePath(cp)\r\n            except: pass\r\n    return {\"model_type\":kind,\"is_cloud_model\":cloud,\"is_workshared\":bool(d.IsWorkshared),\r\n            \"source_display_path\":visible,\"central_display_path\":central}\r\n\r\ndef main_model_path(d):\r\n    try:\r\n        if d.IsModelInCloud: return d.GetCloudModelPath()\r\n    except: pass\r\n    try: return FilePath(d.PathName) if d.PathName else None\r\n    except: return None\r\n\r\ndef room_meta(room):\r\n    out={}\r\n    try: out[\"level_id\"]=eid_int(room.LevelId)\r\n    except: out[\"level_id\"]=None\r\n    try: out[\"level_name\"]=room.Level.Name if room.Level else None\r\n    except: out[\"level_name\"]=None\r\n    # Revit 2027 has no Room.PhaseCreated / Room.PhaseDemolished; the phase\r\n    # ids live on Element as CreatedPhaseId / DemolishedPhaseId.\r\n    try:\r\n        pc=room.CreatedPhaseId\r\n        out[\"phase_created\"]=eid_int(pc) if pc is not None and eid_int(pc)>0 else None\r\n    except: out[\"phase_created\"]=None\r\n    try:\r\n        pd=room.DemolishedPhaseId\r\n        out[\"phase_demolished\"]=eid_int(pd) if pd is not None and eid_int(pd)>0 else None\r\n    except: out[\"phase_demolished\"]=None\r\n    try:\r\n        do=room.DesignOption\r\n        out[\"design_option\"]=eid_int(do.Id) if do is not None else None\r\n    except: out[\"design_option\"]=None\r\n    try:\r\n        ws=room.Document.GetWorksetTable().GetWorkset(room.WorksetId)\r\n        out[\"workset\"]=ws.Name if ws is not None else None\r\n    except: out[\"workset\"]=None\r\n    return out\r\n\r\ndef audit_parameters(room):\r\n    values={}\r\n    for name in AUDIT_PARAMETERS:\r\n        p=room.LookupParameter(name)\r\n        if p is None:\r\n            values[name]={\"status\":\"PARAMETER_NOT_FOUND\",\"value\":None}\r\n            continue\r\n        try:\r\n            if not p.HasValue:\r\n                values[name]={\"status\":\"NO_VALUE\",\"value\":None}\r\n                continue\r\n        except:\r\n            pass\r\n        try:\r\n            # These business parameters are expected to be text. AsString keeps\r\n            # the actual stored text, including blank strings where applicable.\r\n            v=p.AsString()\r\n            if v is None:\r\n                # Defensive fallback if a future parameter is not text based.\r\n                v=p.AsValueString()\r\n            values[name]={\"status\":\"VALUE\",\"value\":v}\r\n        except Exception as ex:\r\n            values[name]={\"status\":\"READ_ERROR\",\"value\":None,\"message\":str(ex)}\r\n    return values\r\n\r\n\r\ndef extract(d,qa):\r\n    opt=SpatialElementBoundaryOptions(); opt.SpatialElementBoundaryLocation=SpatialElementBoundaryLocation.Center\r\n    rooms=list(FilteredElementCollector(d).OfCategory(BuiltInCategory.OST_Rooms).WhereElementIsNotElementType().ToElements())\r\n    stands={}; skipped=errors=fallbacks=unplaced=unbounded=0\r\n    for room in rooms:\r\n        number=(room.Number or \"\").strip(); eid=eid_int(room.Id)\r\n        if not number:\r\n            skipped+=1; qa.append({\"severity\":\"WARNING\",\"element_id\":eid,\"stand_number\":None,\"message\":\"Room skipped because Room Number is blank.\"}); continue\r\n        if number in stands:\r\n            errors+=1; qa.append({\"severity\":\"ERROR\",\"element_id\":eid,\"stand_number\":number,\"message\":\"Duplicate Stand/Room Number; baseline would be ambiguous.\"}); continue\r\n        try:\r\n            # Revit 2027 has no Room.IsPlaced; a placed room has a LocationPoint.\r\n            try: placed=isinstance(room.Location,LocationPoint)\r\n            except: placed=False\r\n            try: segloops=room.GetBoundarySegments(opt)\r\n            except Exception:\r\n                if not placed: segloops=[]\r\n                else: raise\r\n            has_geo=segloops is not None and len(segloops)>0\r\n            meta=room_meta(room)\r\n            try: area=r(room.Area)\r\n            except: area=0.0\r\n            if not has_geo:\r\n                stands[number]={\"element_id\":eid,\"unique_id\":room.UniqueId,\"parameters\":audit_parameters(room),\r\n                    \"placement_status\":\"PLACED\" if placed else \"NOT_PLACED\",\"has_geometry\":False,\r\n                    \"area_internal_sqft\":area,\"perimeter_internal_ft\":None,\"centroid_internal_ft\":None,\r\n                    \"loop_count\":0,\"curve_count\":0,\"fallback_curve_count\":0,\"loops\":[], **meta}\r\n                if placed:\r\n                    unbounded+=1; qa.append({\"severity\":\"WARNING\",\"element_id\":eid,\"stand_number\":number,\"message\":\"Room is placed but has no boundary geometry; retained for audit.\"})\r\n                else:\r\n                    unplaced+=1; qa.append({\"severity\":\"INFO\",\"element_id\":eid,\"stand_number\":number,\"message\":\"Room retained for audit but is not placed on the plan.\"})\r\n                continue\r\n            loops=[]; curvesets=[]; perimeter=0.0; rc=0; cc=0\r\n            for li,segs in enumerate(segloops):\r\n                curves=[s.GetCurve() for s in segs]; curvesets.append(curves); items=[]; length=0.0\r\n                for c in curves:\r\n                    item=curve_json(c); items.append(item); length+=c.Length; cc+=1\r\n                    if item[\"type\"]==\"POLYLINE\": rc+=1\r\n                loops.append({\"loop_index\":li,\"curve_count\":len(items),\"length_internal_ft\":r(length),\"curves\":items}); perimeter+=length\r\n            cen=centroid(curvesets)\r\n            if cen is None and isinstance(room.Location,LocationPoint): cen=room.Location.Point\r\n            if cen is None: raise Exception(\"Could not calculate footprint centroid.\")\r\n            stands[number]={\"element_id\":eid,\"unique_id\":room.UniqueId,\"parameters\":audit_parameters(room),\r\n                \"placement_status\":\"PLACED\" if placed else \"NOT_PLACED\",\"has_geometry\":True,\r\n                \"area_internal_sqft\":area,\"perimeter_internal_ft\":r(perimeter),\"centroid_internal_ft\":jp(cen),\r\n                \"loop_count\":len(loops),\"curve_count\":cc,\"fallback_curve_count\":rc,\"loops\":loops, **meta}\r\n            fallbacks+=rc\r\n        except Exception as ex:\r\n            errors+=1; qa.append({\"severity\":\"ERROR\",\"element_id\":eid,\"stand_number\":number,\"message\":str(ex)})\r\n    return rooms,stands,skipped,errors,fallbacks,unplaced,unbounded\r\n\r\ndef write_json(path,payload):\r\n    tmp=path+\".tmp\"\r\n    try:\r\n        with open(tmp,\"w\",encoding=\"utf-8\") as f: json.dump(payload,f,indent=2,sort_keys=True,ensure_ascii=False); f.write(\"\\n\")\r\n        os.replace(tmp,path)\r\n    finally:\r\n        if os.path.exists(tmp):\r\n            try: os.remove(tmp)\r\n            except: pass\r\n\r\ndef is_central(d):\r\n    try:\r\n        cp=central_model_path(d)\r\n        if cp is None: return False\r\n        return os.path.normcase(ModelPathUtils.ConvertModelPathToUserVisiblePath(cp))==os.path.normcase(d.PathName or \"\")\r\n    except: return False\r\n\r\ndef sync_main(d):\r\n    if d.IsWorkshared:\r\n        if is_central(d):\r\n            if d.IsModified:\r\n                if getattr(d,\"IsModelInCloud\",False): d.SaveCloudModel()\r\n                else: d.Save()\r\n                return \"CENTRAL_SAVED\"\r\n            return \"CENTRAL_NO_CHANGE\"\r\n        t=TransactWithCentralOptions()\r\n        s=SynchronizeWithCentralOptions()\r\n        s.SetRelinquishOptions(RelinquishOptions(False))\r\n        s.SaveLocalAfter=True\r\n        s.Comment=\"Redraw baseline creation\"\r\n        d.SynchronizeWithCentral(t,s)\r\n        return \"SYNCED\"\r\n    if getattr(d,\"IsModelInCloud\",False):\r\n        d.SaveCloudModel(); return \"CLOUD_SAVED\"\r\n    if not d.PathName:\r\n        raise Exception(\"Save Main once before running Create Redraw.\")\r\n    d.Save()\r\n    return \"SAVED\"\r\n\r\ndef check_folder(folder,target,baseline):\r\n    others=[]; others_b=[]\r\n    for n in os.listdir(folder):\r\n        p=os.path.join(folder,n)\r\n        if not os.path.isfile(p): continue\r\n        if n.lower().endswith(\".rvt\") and not re.search(r\"\\.\\d{4}\\.rvt$\",n,re.I):\r\n            if os.path.normcase(os.path.abspath(p))!=os.path.normcase(target): others.append(n)\r\n        if n.lower().endswith(\".baseline.json\"):\r\n            if os.path.normcase(os.path.abspath(p))!=os.path.normcase(baseline): others_b.append(n)\r\n    if others: raise Exception(\"Target directory must contain no other primary RVT files: \"+\", \".join(others))\r\n    if others_b: raise Exception(\"Target directory must contain no other baseline JSON files: \"+\", \".join(others_b))\r\n\r\ndef save_temp_central_detached(d,target,label):\r\n    app=d.Application\r\n    temp=os.path.join(tempfile.gettempdir(),\"redraw_\"+label+\"_\"+uuid.uuid4().hex+\".rvt\")\r\n    temp2=os.path.splitext(temp)[0]+\"_detached.rvt\"\r\n    o=SaveAsOptions(); o.OverwriteExistingFile=False; o.Compact=True\r\n    w=WorksharingSaveAsOptions(); w.SaveAsCentral=True; o.SetWorksharingOptions(w)\r\n    d.SaveAs(temp,o)\r\n    source=temp\r\n    try:\r\n        app.CopyModel(FilePath(temp),temp2,False)\r\n        source=temp2\r\n    except Exception as ex:\r\n        raise Exception(\"Could not copy the temporary central to a detached copy; temporary central remains at \"+temp+\": \"+str(ex))\r\n    opts=OpenOptions(); opts.DetachFromCentralOption=DetachFromCentralOption.DetachAndDiscardWorksets\r\n    det=None\r\n    try:\r\n        det=app.OpenDocumentFile(FilePath(source),opts)\r\n        o2=SaveAsOptions(); o2.OverwriteExistingFile=False; o2.Compact=True\r\n        det.SaveAs(target,o2)\r\n    finally:\r\n        if det is not None:\r\n            try: det.Close(False)\r\n            except: pass\r\n        if source!=temp:\r\n            try: os.remove(source)\r\n            except: pass\r\n    close_doc = d if d.PathName and norm_path(d.PathName)==norm_path(temp) else None\r\n    return \"DETACHED_TEMP_CENTRAL\", close_doc, [temp]\r\n\r\ndef save_detached(d,target,qa):\r\n    app=d.Application\r\n    if not d.IsWorkshared:\r\n        if getattr(d,\"IsModelInCloud\",False):\r\n            o=SaveAsOptions(); o.OverwriteExistingFile=False; o.Compact=True\r\n            d.SaveAs(target,o)\r\n            close_doc=d if d.PathName and norm_path(d.PathName)==norm_path(target) else None\r\n            return \"CLOUD_SAVED\", close_doc, []\r\n        try:\r\n            app.CopyModel(FilePath(d.PathName),target,False)\r\n            return \"COPIED\", None, []\r\n        except Exception as ex:\r\n            qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not copy Main without activating it; falling back to SaveAs: \"+str(ex)})\r\n            if os.path.exists(target):\r\n                try: os.remove(target)\r\n                except: pass\r\n            o=SaveAsOptions(); o.OverwriteExistingFile=False; o.Compact=True\r\n            d.SaveAs(target,o)\r\n            close_doc=d if d.PathName and norm_path(d.PathName)==norm_path(target) else None\r\n            return \"SAVED_COPY\", close_doc, []\r\n    if d.IsModelInCloud:\r\n        return save_temp_central_detached(d,target,\"cloud\")\r\n    try:\r\n        cp=central_model_path(d)\r\n        if cp is None: raise Exception('Document is not workshared; no central model path.')\r\n        opts=OpenOptions(); opts.DetachFromCentralOption=DetachFromCentralOption.DetachAndDiscardWorksets\r\n        det=app.OpenDocumentFile(cp,opts)\r\n        try:\r\n            o=SaveAsOptions(); o.OverwriteExistingFile=False; o.Compact=True\r\n            det.SaveAs(target,o)\r\n        finally:\r\n            det.Close(False)\r\n        return \"DETACHED_LOCAL\", None, []\r\n    except Exception as ex:\r\n        qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not open the central detached; falling back to temporary central flow: \"+str(ex)})\r\n        return save_temp_central_detached(d,target,\"local\")\r\n\r\ndef model_path_text(p):\r\n    try: return os.path.normcase(ModelPathUtils.ConvertModelPathToUserVisiblePath(p))\r\n    except: return None\r\n\r\ndef doc_model_path(d):\r\n    try:\r\n        if d.IsModelInCloud: return d.GetCloudModelPath()\r\n        return FilePath(d.PathName) if d.PathName else None\r\n    except: return None\r\n\r\ndef is_main_active(ui,main_path):\r\n    try:\r\n        active=ui.ActiveUIDocument.Document if ui.ActiveUIDocument else None\r\n        return active is not None and model_path_text(doc_model_path(active))==model_path_text(main_path)\r\n    except: return False\r\n\r\ndef leave_main_active(ui,main_path,close_doc,temp_paths,qa):\r\n    if ui is None or main_path is None:\r\n        if close_doc is None and not temp_paths:\r\n            qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not verify the active document; Main should still be active.\"})\r\n            return True,True,True\r\n        qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not reactivate Main; close the Redraw/temp manually.\"})\r\n        return False,False,False\r\n    if not is_main_active(ui,main_path):\r\n        try:\r\n            ui.OpenAndActivateDocument(main_path,OpenOptions(),False)\r\n        except Exception as ex:\r\n            if not is_main_active(ui,main_path):\r\n                qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not reactivate Main: \"+str(ex)})\r\n                return False,False,False\r\n    if not is_main_active(ui,main_path):\r\n        qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not verify Main as the active document.\"})\r\n        return False,False,False\r\n    close_ok=True\r\n    if close_doc is not None:\r\n        try:\r\n            active=ui.ActiveUIDocument.Document if ui.ActiveUIDocument else None\r\n            if active is not None and model_path_text(doc_model_path(active))==model_path_text(doc_model_path(close_doc)):\r\n                qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Refusing to close the active document.\"})\r\n                close_ok=False\r\n            else:\r\n                close_doc.Close(False)\r\n        except Exception as ex:\r\n            qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not close the previous Redraw/temp document: \"+str(ex)})\r\n            close_ok=False\r\n    temp_ok=True\r\n    for p in temp_paths:\r\n        try: os.remove(p)\r\n        except Exception as ex:\r\n            qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\"message\":\"Could not delete temporary central \"+p+\": \"+str(ex)})\r\n            temp_ok=False\r\n    return True,close_ok,temp_ok\r\n\r\nqa=[]\r\nfolder=as_path(get_in(0))\r\nsummary={\"status\":\"FAILED\",\"source_model_type\":None,\"redraw_path\":None,\"baseline_path\":None,\r\n         \"rooms_collected\":0,\"stands_written\":0,\"rooms_skipped\":0,\"boundary_errors\":0,\r\n         \"unplaced_rooms\":0,\"unbounded_rooms\":0,\"main_active\":None,\"redraw_closed\":None,\r\n         \"temp_central_cleaned\":None}\r\npending=None; target=None; baseline=None\r\ntry:\r\n    if doc is None or doc.IsFamilyDocument: raise Exception(\"Run from an open Revit project model.\")\r\n    if not folder: raise Exception(\"IN[0] must be a target Directory Path.\")\r\n    folder=os.path.abspath(folder.strip())\r\n    if not os.path.isdir(folder): raise Exception(\"Target directory does not exist: \"+folder)\r\n    title=doc.Title[:-4] if doc.Title.lower().endswith(\".rvt\") else doc.Title\r\n    target=os.path.join(folder,title+\".rvt\")\r\n    baseline=os.path.splitext(target)[0]+\".baseline.json\"\r\n    summary[\"redraw_path\"]=target; summary[\"baseline_path\"]=baseline\r\n    if os.path.exists(target) or os.path.exists(baseline): raise Exception(\"Redraw or baseline already exists; choose another directory or rename/remove the existing pair.\")\r\n    check_folder(folder,target,baseline)\r\n    summary[\"main_save_status\"]=sync_main(doc)\r\n    if doc.IsModified: raise Exception(\"Main still has unsaved changes after save/sync.\")\r\n    sm=source_meta(doc); summary[\"source_model_type\"]=sm[\"model_type\"]\r\n    main_path=main_model_path(doc)\r\n    rooms,stands,skipped,errors,fallbacks,unplaced,unbounded=extract(doc,qa)\r\n    summary.update({\"rooms_collected\":len(rooms),\"stands_written\":len(stands),\"rooms_skipped\":skipped,\r\n                    \"boundary_errors\":errors,\"unplaced_rooms\":unplaced,\"unbounded_rooms\":unbounded,\r\n                    \"polyline_fallback_curves\":fallbacks})\r\n    if not stands: raise Exception(\"No numbered rooms were available for the baseline.\")\r\n    if errors: raise Exception(\"Baseline extraction has errors. Resolve ERROR entries before creating Redraw.\")\r\n    bid=str(uuid.uuid4()); summary[\"baseline_id\"]=bid\r\n    info=doc.ProjectInformation\r\n    source_workshared=bool(doc.IsWorkshared)\r\n    output_type=\"LOCAL_DETACHED\" if source_workshared else \"LOCAL\"\r\n    payload={\"schema_version\":\"1.0\",\"snapshot_type\":\"REDRAW_BASELINE\",\"baseline_id\":bid,\r\n      \"created_utc\":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\",\"Z\"),\r\n      \"redraw\":{\"filename\":os.path.basename(target),\"sidecar_filename\":os.path.basename(baseline),\r\n                \"output_type\":output_type,\"is_workshared\":False,\"detached_from_central\":source_workshared},\r\n      \"source\":{\"document_title\":doc.Title,\"source_display_path\":sm[\"source_display_path\"],\"central_display_path\":sm[\"central_display_path\"],\r\n                \"model_type\":sm[\"model_type\"],\"project_name\":getattr(info,\"Name\",\"\") or \"\",\"project_number\":getattr(info,\"Number\",\"\") or \"\",\r\n                \"revit_version\":doc.Application.VersionNumber,\"is_cloud_model\":sm[\"is_cloud_model\"],\"is_workshared\":sm[\"is_workshared\"]},\r\n      \"canonical_units\":{\"system\":\"REVIT_INTERNAL\",\"length\":\"feet\",\"area\":\"square_feet\",\"coordinates\":\"feet\"},\r\n      \"project_display_units\":unit_meta(doc),\r\n      \"extraction_settings\":{\"boundary_location\":\"Center\",\"coordinate_decimals\":DEC,\"measurement_decimals\":DEC,\r\n                \"fallback_tessellation_max_chord_internal_ft\":r(MAX_CHORD_FT),\r\n                \"audited_room_parameters\":AUDIT_PARAMETERS,\"merge_parameters\":MERGE_PARAMETERS},\r\n      \"counts\":{\"rooms_collected\":len(rooms),\"stands_written\":len(stands),\"rooms_skipped\":skipped,\r\n                \"boundary_errors\":errors,\"unplaced_rooms\":unplaced,\"unbounded_rooms\":unbounded,\r\n                \"polyline_fallback_curves\":fallbacks},\r\n      \"stands\":stands}\r\n    pending=baseline+\".pending\"\r\n    write_json(pending,payload)\r\n    mode,close_doc,temp_paths=save_detached(doc,target,qa)\r\n    summary[\"redraw_mode\"]=mode\r\n    os.replace(pending,baseline); pending=None\r\n    if not os.path.isfile(target) or os.path.getsize(target)==0: raise Exception(\"Redraw RVT verification failed after SaveAs.\")\r\n    if not os.path.isfile(baseline) or os.path.getsize(baseline)==0: raise Exception(\"Baseline JSON verification failed after SaveAs.\")\r\n    try: ui=DocumentManager.Instance.CurrentUIApplication\r\n    except: ui=None\r\n    main_ok,close_ok,temp_ok=leave_main_active(ui,main_path,close_doc,temp_paths,qa)\r\n    summary[\"main_active\"]=bool(main_ok)\r\n    summary[\"redraw_closed\"]=bool(close_ok)\r\n    summary[\"temp_central_cleaned\"]=bool(temp_ok)\r\n    if main_ok and close_ok and temp_ok:\r\n        summary[\"status\"]=\"SUCCESS\"\r\n        summary[\"message\"]=\"Redraw created and closed. Main is active. Close Main, open the Redraw to edit; save/close it, reopen Main, then run Compare and Update Redraw.\"\r\n    else:\r\n        summary[\"status\"]=\"SUCCESS WITH WARNINGS\"\r\n        summary[\"message\"]=\"Redraw created, but active-document cleanup was incomplete. See QA; activate Main and close the Redraw/temp manually.\"\r\nexcept Exception as ex:\r\n    if pending and os.path.exists(pending):\r\n        try: os.remove(pending)\r\n        except: pass\r\n    if target and os.path.exists(target):\r\n        qa.append({\"severity\":\"WARNING\",\"element_id\":None,\"stand_number\":None,\r\n            \"message\":\"A Redraw file may exist at \"+target+\"; delete the Redraw/baseline pair before retrying.\"})\r\n    qa.append({\"severity\":\"FATAL\",\"element_id\":None,\"stand_number\":None,\"message\":str(ex)})\r\nOUT=summary,qa\r\n",
